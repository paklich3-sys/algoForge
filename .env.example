# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID вашего личного чата с ботом (число, например 123456789).
# Как получить: напишите боту /start, затем откройте в браузере:
# https://api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates
# и найдите "chat":{"id": ...} — это и есть TELEGRAM_CHAT_ID.
TELEGRAM_CHAT_ID=

# Порт сервера (Render подставляет PORT автоматически)
PORT=4173
